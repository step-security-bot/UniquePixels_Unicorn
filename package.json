{
	"name": "unicorn",
	"version": "0.0.1",
	"description": "Unicorn is a framework for building Discord bots with ease using Discord.js and TypeScript, and built to run on Bun.",
	"author": "Brian L. <brian@uniquepixels.xyz> (http://uniquepixels.xyz)",
	"contributors": [],
	"repository": {
		"type": "git",
		"url": "https://github.com/uniquepixels/unicorn.git"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "bun --preload ./src/sentry.ts ./src/index.ts",
		"lint": "bun lint:format && bun lint:code; bun lint:tsc;",
		"lint:format": "biome format --write",
		"lint:ci": "biome ci --reporter=github --diagnostic-level=warn",
		"lint:code": "biome check",
		"lint:tsc": "tsc --noEmit --skipLibCheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@commitlint/types": "^20.4.0",
		"@types/bun": "1.3.9",
		"pino-pretty": "^13.1.3",
		"typescript": "^5.9.3"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"dependencies": {
		"@sentry/bun": "^10.41.0",
		"cron": "^4.4.0",
		"discord.js": "^14.25.1",
		"pino": "^10.3.1",
		"zod": "^4.3.6"
	}
}
