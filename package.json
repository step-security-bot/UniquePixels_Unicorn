{
	"name": "unicorn",
	"version": "0.0.1",
	"description": "Unicorn is a framework for building Discord bots with ease using Discord.js and TypeScript, and built to run on Bun.",
	"author": "Brian L. <brian@uniquepixels.xyz> (http://uniquepixels.xyz)",
	"contributors": [],
	"repository": {
		"type": "git",
		"url": "https://github.com/uniquepixels/unicorn.git"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "bun --preload ./src/sentry.ts ./src/index.ts",
		"qa": "bun qa:format && bun qa:lint; bun qa:tsc; bun qa:test",
		"qa:format": "biome format --write",
		"qa:lint": "biome check",
		"qa:lint-ci": "biome ci --reporter=github --diagnostic-level=warn",
		"qa:tsc": "tsc --noEmit --skipLibCheck",
		"qa:test": "bun test && bun scripts/patch-lcov.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@commitlint/types": "^20.4.3",
		"@types/bun": "1.3.10",
		"pino-pretty": "^13.1.3",
		"typescript": "^5.9.3"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"dependencies": {
		"@sentry/bun": "^10.42.0",
		"cron": "^4.4.0",
		"discord.js": "^14.25.1",
		"pino": "^10.3.1",
		"serialize-error": "^13.0.1",
		"zod": "^4.3.6"
	}
}
